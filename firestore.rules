rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(tripData) {
      return isSignedIn() && request.auth.uid == tripData.ownerId;
    }

    function isParticipant(tripData) {
      return isSignedIn() &&
        tripData.participantUids is list &&
        request.auth.uid in tripData.participantUids;
    }

    function canRead(tripData) {
      return isOwner(tripData) || isParticipant(tripData);
    }

    function canWrite(tripData) {
      // Owner can always write; participants need 'editor' role
      if (isOwner(tripData)) return true;
      let me = tripData.participants.filter(p, p.uid == request.auth.uid);
      return me.size() > 0 && me[0].role == 'editor';
    }

    // ── Trips ─────────────────────────────────────────────────────────────────

    match /trips/{tripId} {
      // Read: owner or any participant
      allow read: if canRead(resource.data);

      // Create: authenticated user, must set themselves as owner
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;

      // Update: owner or editor; ownerId must not change
      allow update: if canWrite(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId;

      // Delete: owner only
      allow delete: if isOwner(resource.data);
    }

    // ── Rate limit counters (Cloud Function only) ──────────────────────────────
    // These are written server-side with Admin SDK — deny all client access.
    match /_rateLimits/{document=**} {
      allow read, write: if false;
    }

    // ── Default deny ──────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
