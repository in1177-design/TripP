rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── CURRENT STATE (intentionally permissive) ───────────────────────────
    // The app does not yet implement per-user ownership or sharing.
    // All authenticated Firebase users (including anonymous sessions) can
    // read and write all trips.  This is acceptable for a personal/family app
    // where the Firebase project is private and the owner controls access.
    //
    // NOTE: These rules require Firebase Auth to be enabled and every client
    // to sign in (at minimum anonymously) before accessing Firestore.
    // The current codebase uses anonymous sign-in automatically on startup.
    //
    // ─── MIGRATION PATH ─────────────────────────────────────────────────────
    // When proper multi-user support is needed, replace this block with:
    //
    //   match /trips/{tripId} {
    //     // Owner can do everything
    //     allow read, write, delete: if request.auth != null
    //                                && request.auth.uid == resource.data.ownerId;
    //     // Shared users can read only
    //     allow read: if request.auth != null
    //                 && request.auth.uid in resource.data.sharedWith;
    //   }
    //
    // Before deploying strict rules, run the migration script:
    //   npx tsx scripts/migrate-add-owners.ts
    // which stamps every existing trip document with ownerId = <your UID>.
    // ────────────────────────────────────────────────────────────────────────

    match /trips/{tripId} {
      // Any authenticated session (incl. anonymous) can read / write.
      // This preserves existing behaviour while blocking completely
      // unauthenticated access from scripts or unknown clients.
      allow read, write: if request.auth != null;
    }
  }
}
