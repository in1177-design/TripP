rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(tripData) {
      return isSignedIn() && request.auth.uid == tripData.ownerId;
    }

    // participantUids contains ALL shared users (editors + viewers)
    function isParticipant(tripData) {
      return isSignedIn()
        && tripData.participantUids is list
        && request.auth.uid in tripData.participantUids;
    }

    // editorUids contains only users with write permission
    // Falls back to participantUids if editorUids is not set (backwards compat)
    function isEditor(tripData) {
      return isSignedIn()
        && (
          (tripData.keys().hasAll(['editorUids'])
            && tripData.editorUids is list
            && request.auth.uid in tripData.editorUids)
          ||
          (!tripData.keys().hasAll(['editorUids'])
            && tripData.participantUids is list
            && request.auth.uid in tripData.participantUids)
        );
    }

    // ── Trips ─────────────────────────────────────────────────────────────────

    match /trips/{tripId} {

      // Read: owner or any participant
      allow read: if isOwner(resource.data) || isParticipant(resource.data);

      // Create: signed-in user who stamps themselves as owner
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;

      // Update: owner or editor; ownerId must not change
      allow update: if (isOwner(resource.data) || isEditor(resource.data))
        && request.resource.data.ownerId == resource.data.ownerId;

      // Delete: owner only
      allow delete: if isOwner(resource.data);
    }

    // ── Rate limit counters — server-side Admin SDK only ───────────────────────
    match /_rateLimits/{document=**} {
      allow read, write: if false;
    }

    // ── Default deny ──────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
